# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_ALLOWED_USERS=

# Storage
DB_PATH=/data/gosift.db

# Logging
LOG_LEVEL=info                      # debug|info|warn|error
LOG_FORMAT=text                     # text|json

# Parsing
PARSE_INTERVAL=15m
PARSE_JITTER=3s
PARSE_TIMEOUT=20s
PARSE_LIMIT=20
PARSE_RETRIES=3
PARSE_RETRY_BACKOFF=5s
NOTIFY_ALERT_INTERVAL=1h

# Network
HTTP_PROXY=
USER_AGENT=Mozilla/5.0 (compatible; gosift-bot)

# Stores
STORE_KOMISSIONKI_BASE_URL=https://komissionki.ru
STORE_KOMISSIONKI_API_URL=https://saf.komissionki.ru
STORE_KOMISSIONKI_ENABLED=true
STORE_KOMISSIONKI_RPS=0.5
