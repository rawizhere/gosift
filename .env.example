# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...        # обязательно, от @BotFather
TELEGRAM_ALLOWED_USERS=                 # опционально: user_id через запятую; пусто = выключен

# Хранилище
DB_PATH=/data/gosift.db

# Логи
LOG_LEVEL=info                          # debug|info|warn|error
LOG_FORMAT=text                         # text|json

# Парсинг
PARSE_INTERVAL=15m                      # общий период цикла, один для всех правил
PARSE_JITTER=3s                         # макс. случайная пауза между запросами
PARSE_TIMEOUT=20s
PARSE_LIMIT=20
PARSE_RETRIES=3
PARSE_RETRY_BACKOFF=5s
NOTIFY_ALERT_INTERVAL=1h

# Сеть (опционально)
HTTP_PROXY=
USER_AGENT=Mozilla/5.0 (compatible; gosift-bot)

# Магазины
STORE_KOMISSIONKI_BASE_URL=https://komissionki.ru
STORE_KOMISSIONKI_ENABLED=true
STORE_KOMISSIONKI_RPS=0.5
